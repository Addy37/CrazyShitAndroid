<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_controls_scrim" />

    <LinearLayout
        android:id="@id/exo_top_controls"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="@drawable/player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/player_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Back"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_back" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Video"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/player_portrait_fullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Portrait fullscreen"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_fullscreen"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/player_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Video actions"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="ltr"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Seek back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_rewind" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/player_control_button_primary"
            android:contentDescription="Play or pause"
            android:padding="17dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_play" />

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Seek forward"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_forward" />
    </LinearLayout>

    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bottom_scrim"
        android:layoutDirection="ltr">

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="31dp"
            app:ad_marker_color="#CCFFFFFF"
            app:bar_height="3dp"
            app:buffered_color="#A6FFFFFF"
            app:played_ad_marker_color="@color/app_primary"
            app:played_color="@color/app_primary"
            app:scrubber_color="@color/app_primary"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="11dp"
            app:touch_target_height="34dp"
            app:unplayed_color="#5CFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:text="  /  "
                android:textColor="#A8FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:textColor="#C8FFFFFF"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/player_control_button"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Drag the timeline to seek"
                android:textColor="#C8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</merge>
