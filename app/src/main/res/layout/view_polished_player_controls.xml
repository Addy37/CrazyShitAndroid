<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_controls_scrim" />

    <LinearLayout
        android:id="@id/exo_top_controls"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@drawable/player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/player_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Back"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_back" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Video"
            android:textColor="#F7FFFFFF"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/player_portrait_fullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Portrait fullscreen"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_fullscreen"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/player_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/player_control_button"
            android:contentDescription="Video actions"
            android:elevation="2dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="ltr"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="16dp">

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/player_control_button"
                android:contentDescription="Back 10 seconds"
                android:elevation="2dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_rewind" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="10"
                android:textColor="#F2FFFFFF"
                android:textSize="8sp" />
        </FrameLayout>

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/player_control_button_primary"
            android:contentDescription="Play or pause"
            android:elevation="3dp"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_play" />

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp">

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/player_control_button"
                android:contentDescription="Forward 10 seconds"
                android:elevation="2dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_forward" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="10"
                android:textColor="#F2FFFFFF"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bottom_scrim"
        android:layoutDirection="ltr">

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:ad_marker_color="#BFFFFFFF"
            app:bar_height="2dp"
            app:buffered_color="#7AFFFFFF"
            app:played_ad_marker_color="@color/app_primary"
            app:played_color="@color/app_primary"
            app:scrubber_color="@color/app_primary"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="12dp"
            app:scrubber_enabled_size="8dp"
            app:touch_target_height="30dp"
            app:unplayed_color="#45FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:textColor="#F7FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:text="  •  "
                android:textColor="#8FFFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:textColor="#BFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</merge>
