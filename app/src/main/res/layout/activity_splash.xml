<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/splashGlow"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/splash_orange_glow" />

    <ImageView
        android:id="@+id/splashArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_art" />

    <View
        android:id="@+id/splashSweep"
        android:layout_width="150dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/splash_light_streak" />
</FrameLayout>
