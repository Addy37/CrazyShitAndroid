<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CrazyShit.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/app_surface</item>
        <item name="backgroundTint">@color/app_surface</item>
        <item name="android:minHeight">64dp</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
        <item name="itemTextColor">@color/nav_text_tint</item>
        <item name="itemRippleColor">@color/nav_ripple</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">7dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.CrazyShit.BottomNav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.CrazyShit.BottomNav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CrazyShit.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.CrazyShit.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">52dp</item>
        <item name="android:height">30dp</item>
        <item name="android:color">#2BFF5A1F</item>
    </style>

    <style name="TextAppearance.CrazyShit.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
