<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected navigation keeps the cyan rim but avoids the previous neon capsule effect. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A70B2634"
                android:centerColor="#B9091822"
                android:endColor="#DB070C11" />
            <stroke android:width="2dp" android:color="#3F0892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#400892D0"
                android:centerColor="#B30B2634"
                android:endColor="#D20A1016" />
            <stroke android:width="1dp" android:color="#A00892D0" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Diffuse upper sheen replaces the bright white cap and lower reflection line. -->
    <item
        android:left="9dp"
        android:top="4dp"
        android:right="13dp"
        android:height="11dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26B7E0F2"
                android:centerColor="#120892D0"
                android:endColor="#000892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>
</layer-list>
