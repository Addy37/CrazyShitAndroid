<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Diffuse outer rim. Layered strokes simulate glow without bitmap assets. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C51A303A"
                android:centerColor="#D5101A22"
                android:endColor="#ED070C11" />
            <stroke android:width="3dp" android:color="#5222D3EE" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Bright glass rim and darker translucent interior. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#7422D3EE"
                android:centerColor="#CC12303A"
                android:endColor="#E00A1016" />
            <stroke android:width="1dp" android:color="#E622D3EE" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Upper internal sheen. -->
    <item
        android:left="7dp"
        android:top="4dp"
        android:right="7dp"
        android:height="15dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#62EAFBFF"
                android:centerColor="#2F22D3EE"
                android:endColor="#0022D3EE" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Concentrated, partial specular reflection. -->
    <item
        android:left="12dp"
        android:top="3dp"
        android:right="18dp"
        android:height="2dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#35FFFFFF"
                android:centerColor="#F2F4FEFF"
                android:endColor="#5522D3EE" />
            <corners android:radius="1dp" />
        </shape>
    </item>

    <!-- Secondary low reflection keeps the tall capsule from reading flat. -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:bottom="4dp"
        android:height="1dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0022D3EE"
                android:centerColor="#7022D3EE"
                android:endColor="#0022D3EE" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
