<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state stays clear, marked by a brighter cyan optical rim. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#780892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#C80892D0" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Restrained highlight, no milky fill. -->
    <item
        android:left="10dp"
        android:top="3dp"
        android:right="18dp"
        android:height="2dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#9CF4FCFF"
                android:endColor="#360892D0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
