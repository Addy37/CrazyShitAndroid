<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F21A1D22"
                android:centerColor="#F012171C" android:endColor="#F0080B0E" />
            <stroke android:width="1dp" android:color="#465BBBE2" />
            <corners android:radius="@dimen/zc_radius_large" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#180892D0"
                android:centerColor="#085BBBE2" android:endColor="#00000000" />
            <corners android:radius="@dimen/zc_radius_large" />
        </shape>
    </item>
    <item android:left="32dp" android:right="32dp" android:top="3dp"
        android:height="9dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#18B7E0F2"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/zc_radius_large" />
        </shape>
    </item>
</layer-list>
