<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#96151B21"
                android:centerColor="#7A0B1015"
                android:endColor="#A6070A0E" />
            <stroke android:width="1dp" android:color="#700892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#080892D0"
                android:endColor="#10000000" />
            <stroke android:width="1dp" android:color="#1EFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="2dp"
        android:right="10dp"
        android:height="2dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#76E9F7FF"
                android:endColor="#2A0892D0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
