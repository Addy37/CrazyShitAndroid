<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#88151B21"
                android:centerColor="#700B1015"
                android:endColor="#95070A0E" />
            <stroke android:width="1dp" android:color="#600892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0EFFFFFF"
                android:centerColor="#060892D0"
                android:endColor="#0D000000" />
            <stroke android:width="1dp" android:color="#16FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Small controls get only a diffuse cap, never a bright specular streak. -->
    <item
        android:left="8dp"
        android:top="3dp"
        android:right="12dp"
        android:height="7dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12E9F7FF"
                android:centerColor="#060892D0"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
