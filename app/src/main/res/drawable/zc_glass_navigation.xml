<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Clear optical shell. No smoked or dark fill. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#780892D0" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Faint inner rim gives the clear surface thickness without tinting content. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Small top reflection only. -->
    <item
        android:left="18dp"
        android:top="2dp"
        android:right="42dp"
        android:height="3dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#6EEAF8FF"
                android:endColor="#200892D0" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Very faint lower light catch. -->
    <item
        android:left="24dp"
        android:right="24dp"
        android:bottom="2dp"
        android:height="1dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#000892D0"
                android:centerColor="#380892D0"
                android:endColor="#000892D0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
