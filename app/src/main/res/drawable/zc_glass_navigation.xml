<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smoked glass body and restrained cyan edge light. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#701B222A"
                android:centerColor="#5211171E"
                android:endColor="#78070A0E" />
            <stroke android:width="1dp" android:color="#4D5EDCF3" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Soft internal depth below the reflective edge. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2219D9F2"
                android:centerColor="#128DEBFA"
                android:endColor="#26000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Broad upper reflection, visible without turning the bar cyan. -->
    <item
        android:left="12dp"
        android:top="2dp"
        android:right="12dp"
        android:height="12dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38EAFBFF"
                android:centerColor="#1522D3EE"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Narrow specular streak makes the reflection read as glass. -->
    <item
        android:left="24dp"
        android:top="1dp"
        android:right="58dp"
        android:height="2dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#B8EAFBFF"
                android:endColor="#2422D3EE" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
