<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Smoked glass body with restrained cyan edge light. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#701B222A"
                android:centerColor="#5211171E"
                android:endColor="#78070A0E" />
            <stroke android:width="1dp" android:color="#465BBBE2" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>

    <!-- Soft internal depth without a hard reflective line. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#160892D0"
                android:centerColor="#0C5BBBE2"
                android:endColor="#24000000" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Centered, low-contrast sheen follows the capsule instead of reading as an offset bar. -->
    <item
        android:left="24dp"
        android:top="3dp"
        android:right="24dp"
        android:height="8dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14B7E0F2"
                android:centerColor="#075BBBE2"
                android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/zc_radius_pill" />
        </shape>
    </item>
</layer-list>
